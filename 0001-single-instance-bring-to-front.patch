From 61df0f274ab18b96fd6e8ac4023330da51e07d75 Mon Sep 17 00:00:00 2001
From: Patch <patch@example.com>
Date: Mon, 16 Nov 2026 07:36:21 +0000
Subject: [PATCH] feat: bring existing window to front when app is launched a
 second time

---
 src/bin/gui.rs | 65 ++++++++++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 65 insertions(+)

diff --git a/src/bin/gui.rs b/src/bin/gui.rs
index 6ce46bd..276c4e1 100644
--- a/src/bin/gui.rs
+++ b/src/bin/gui.rs
@@ -4,6 +4,8 @@ use dune_save_manager::*;
 use eframe::egui::{self, Align2, Color32, FontId, RichText, Sense, Vec2};
 use serde::{Deserialize, Serialize};
 use std::{
+    io::{Read, Write},
+    net::{Ipv4Addr, SocketAddr, TcpListener, TcpStream},
     path::{Path, PathBuf},
     sync::{
         atomic::{AtomicBool, Ordering},
@@ -927,7 +929,67 @@ impl eframe::App for App {
     }
 }
 
+/// Single-instance guard: the first instance owns a loopback TCP port. A second launch connects to it, asks the
+/// running instance to come to the front, and exits. If the port is taken by something that doesn't answer our
+/// handshake, we just start normally.
+const INSTANCE_ADDR: SocketAddr = SocketAddr::new(std::net::IpAddr::V4(Ipv4Addr::LOCALHOST), 47653);
+const SHOW_MSG: &[u8] = b"DuneSaveManager:show\n";
+const SHOW_ACK: &[u8] = b"ok\n";
+
+enum Instance {
+    /// We are the first instance (or the guard is unavailable); keep the listener, if any.
+    Primary(Option<TcpListener>),
+    /// An existing instance was told to show itself.
+    Existing,
+}
+
+fn claim_instance() -> Instance {
+    match TcpListener::bind(INSTANCE_ADDR) {
+        Ok(l) => Instance::Primary(Some(l)),
+        Err(_) => {
+            let timeout = Duration::from_millis(1500);
+            if let Ok(mut s) = TcpStream::connect_timeout(&INSTANCE_ADDR, timeout) {
+                let _ = s.set_read_timeout(Some(timeout));
+                let _ = s.set_write_timeout(Some(timeout));
+                let mut buf = [0u8; 8];
+                if s.write_all(SHOW_MSG).is_ok() && s.read(&mut buf).map_or(false, |n| &buf[..n] == SHOW_ACK) {
+                    return Instance::Existing;
+                }
+            }
+            Instance::Primary(None)
+        }
+    }
+}
+
+fn bring_to_front(ctx: &egui::Context) {
+    use egui::{ViewportCommand, WindowLevel};
+    ctx.send_viewport_cmd(ViewportCommand::Visible(true));
+    ctx.send_viewport_cmd(ViewportCommand::Minimized(false));
+    // Toggling "always on top" helps get past focus-stealing prevention on some platforms.
+    ctx.send_viewport_cmd(ViewportCommand::WindowLevel(WindowLevel::AlwaysOnTop));
+    ctx.send_viewport_cmd(ViewportCommand::WindowLevel(WindowLevel::Normal));
+    ctx.send_viewport_cmd(ViewportCommand::Focus);
+}
+
+fn start_instance_listener(listener: TcpListener, ctx: egui::Context) {
+    std::thread::spawn(move || {
+        for conn in listener.incoming() {
+            let Ok(mut s) = conn else { continue };
+            let _ = s.set_read_timeout(Some(Duration::from_millis(500)));
+            let mut buf = [0u8; 64];
+            if s.read(&mut buf).map_or(false, |n| &buf[..n] == SHOW_MSG) {
+                let _ = s.write_all(SHOW_ACK);
+                bring_to_front(&ctx);
+            }
+        }
+    });
+}
+
 fn main() -> eframe::Result<()> {
+    let listener = match claim_instance() {
+        Instance::Existing => return Ok(()),
+        Instance::Primary(l) => l,
+    };
     let mut viewport = egui::ViewportBuilder::default().with_min_inner_size([800.0, 500.0]);
     match load_window_state() {
         Some(w) => {
@@ -949,6 +1011,9 @@ fn main() -> eframe::Result<()> {
             egui_extras::install_image_loaders(&cc.egui_ctx);
             let app = App::new();
             app.start_watcher(cc.egui_ctx.clone());
+            if let Some(l) = listener {
+                start_instance_listener(l, cc.egui_ctx.clone());
+            }
             Box::new(app)
         }),
     )
